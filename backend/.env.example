# App
APP_NAME=Mail Reply Engine
ENVIRONMENT=development
HOST=0.0.0.0
PORT=2101
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:2102"]
FRONTEND_URL=http://localhost:2102
TIMEZONE=Asia/Kolkata
COMPANY_NAME=TCG Digital

# Postgres
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_DB_NAME=mail_reply_engine
POSTGRES_DB_USER=postgres
POSTGRES_DB_PASSWORD=

# JWT
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Queue
REDIS_URL=redis://localhost:6379/0
EVENT_DISPATCH_MODE=inline

# Microsoft Graph
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=HROperations@tcgdigital.com
GRAPH_WEBHOOK_BASE_URL=https://api.your-domain
GRAPH_CLIENT_STATE=

# MinIO
S3_ENDPOINT_URL=http://localhost:2103
S3_PUBLIC_ENDPOINT_URL=http://localhost:2103
S3_BUCKET=mail-reply-engine
PHOTO_MAX_BYTES=5242880
PHOTO_URL_EXPIRE_SECONDS=3600
S3_ACCESS_KEY=
S3_SECRET_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_REASONING_EFFORT=low
LOG_AI_PAYLOADS=false

# PII encryption
PII_ENCRYPTION_KEYS={"key-2026-10": ""}
PII_ACTIVE_KEY_ID=key-2026-10
PII_INDEX_KEY=

# Docker deployment, credentials above are reused unchanged
BACKEND_PORT=2101
BACKEND_BIND=0.0.0.0
DOCKER_ENVIRONMENT=development
DOCKER_POSTGRES_HOST=doe-postgres
DOCKER_POSTGRES_PORT=5432
DB_NETWORK=doe-net
APP_NETWORK=mail-reply-engine-network
