# App
APP_NAME=Mail Reply Engine
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000
TIMEZONE=Asia/Kolkata
COMPANY_NAME=TCG Digital

# Postgres
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_DB_NAME=mail_reply_engine
POSTGRES_DB_USER=postgres
POSTGRES_DB_PASSWORD=

# JWT
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Queue
REDIS_URL=redis://mail-reply-engine-redis:6379/0
EVENT_DISPATCH_MODE=celery

# Microsoft Graph
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=HROperations@tcgdigital.com
GRAPH_WEBHOOK_BASE_URL=https://api.your-domain
GRAPH_CLIENT_STATE=

# SMTP
MAIL_SEND_PROVIDER=graph
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=HROperations@tcgdigital.com
SMTP_FROM_NAME=HR Operations

# MinIO
S3_ENDPOINT_URL=http://mail-reply-engine-minio:9000
S3_PUBLIC_ENDPOINT_URL=https://files.your-domain
S3_BUCKET=mail-reply-engine
S3_ACCESS_KEY=
S3_SECRET_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_REASONING_EFFORT=low

# PII encryption
PII_ENCRYPTION_KEYS={"key-2026-10": ""}
PII_ACTIVE_KEY_ID=key-2026-10
PII_INDEX_KEY=
