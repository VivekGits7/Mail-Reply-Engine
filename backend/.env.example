APP_NAME=Mail Reply Engine
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000
TIMEZONE=Asia/Kolkata
COMPANY_NAME=TCG Digital

POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_DB_NAME=mail_reply_engine
POSTGRES_DB_USER=postgres
POSTGRES_DB_PASSWORD=

JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# inline runs events inside the API, celery needs the worker and beat containers
REDIS_URL=redis://mail-reply-engine-redis:6379/0
EVENT_DISPATCH_MODE=celery

# Entra app registration, scoped by IT to the dedicated mailbox
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=hr-agent@tcgdigital.com
GRAPH_WEBHOOK_BASE_URL=https://api.your-domain
GRAPH_CLIENT_STATE=

# MinIO from services/minio, the backend user keys only, never root
S3_ENDPOINT_URL=http://mail-reply-engine-minio:9000
S3_PUBLIC_ENDPOINT_URL=https://files.your-domain
S3_BUCKET=mail-reply-engine
S3_ACCESS_KEY=
S3_SECRET_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_REASONING_EFFORT=low

# Generate with: python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# Back these up outside the VM, losing them loses every encrypted field
PII_ENCRYPTION_KEYS={"key-2026-10": ""}
PII_ACTIVE_KEY_ID=key-2026-10
PII_INDEX_KEY=
