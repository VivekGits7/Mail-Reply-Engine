# Copy to .env and fill in. Never commit .env.

# Pin a digest after the first pull, e.g. cgr.dev/chainguard/minio@sha256:...
MINIO_IMAGE=cgr.dev/chainguard/minio:latest
MINIO_CONTAINER_NAME=mail-reply-engine-minio
MINIO_NETWORK=mail-reply-engine-network

# Admin login, used only by the console and the init job. Generate with: openssl rand -base64 24
MINIO_ROOT_USER=mre-admin
MINIO_ROOT_PASSWORD=replace-with-a-strong-password

# Encryption key for data at rest. Generate with: echo "mre-key:$(openssl rand -base64 32)"
# Back it up outside this VM. Losing it means losing every stored file.
MINIO_KMS_SECRET_KEY=mre-key:replace-with-a-base64-32-byte-key

MINIO_BUCKET=mail-reply-engine

# Keys the backend uses, limited to MINIO_BUCKET. Generate the secret with: openssl rand -base64 24
MINIO_APP_ACCESS_KEY=mre-app
MINIO_APP_SECRET_KEY=replace-with-a-strong-secret

# Keep both binds on 127.0.0.1 and put an HTTPS reverse proxy in front of the API
MINIO_API_BIND=127.0.0.1
MINIO_API_PORT=9100
MINIO_CONSOLE_BIND=127.0.0.1
MINIO_CONSOLE_PORT=9101

# Dashboard origin allowed to upload with presigned URLs
MINIO_CORS_ALLOW_ORIGIN=http://localhost:3000
